# Copy to .env.local and fill in. All values are server-only (never shipped to the browser).

# AI chat widget — key from https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...

# Contact form
# Where submissions are delivered:
CONTACT_EMAIL=se
# Sender API key from https://resend.com (free tier is plenty):
RESEND_API_KEY=re_...

# Production domain for SEO/canonical/sitemap (public by design)
# NEXT_PUBLIC_SITE_URL=https://your-domain.dev

# AI chat – free alternative to Anthropic (takes priority when set)
# Key from https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=AIza...

# Optional free backup for the chat: used automatically when Gemini is rate-limited
# Key from https://console.groq.com (free, no card)
GROQ_API_KEY=gsk_...
